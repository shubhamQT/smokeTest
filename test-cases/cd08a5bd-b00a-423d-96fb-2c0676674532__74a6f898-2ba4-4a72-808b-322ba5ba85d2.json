{
  "id": "74a6f898-2ba4-4a72-808b-322ba5ba85d2",
  "testPlanId": "cd08a5bd-b00a-423d-96fb-2c0676674532",
  "requirementId": "ad602e65-391d-40c1-ae6f-77a286abdd24",
  "suiteName": "Shopping Cart — Add $10.90 Product and Validate Cart (E2E)",
  "case": {
    "id": "74a6f898-2ba4-4a72-808b-322ba5ba85d2",
    "title": "Add the $10.90 product to cart and validate cart details",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Navigate to Shopping Cart app",
        "value": "https://react-shopping-cart-67954.firebaseapp.com/"
      },
      {
        "id": "s2",
        "action": "waitForVisible",
        "targetDescription": "Product grid is visible",
        "locatorHint": "css=.products"
      },
      {
        "id": "s3",
        "action": "assertContainsText",
        "targetDescription": "Confirm $10.90 price is present in product grid",
        "locatorHint": "css=.products",
        "assertion": "$10.90"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Tap 'Add to cart' on the product priced $10.90",
        "locatorHint": "product card containing price \"$10.90\" -> button text: Add to cart"
      },
      {
        "id": "s5",
        "action": "waitForVisible",
        "targetDescription": "Cart drawer auto-opens after adding",
        "locatorHint": "css=.float-cart__content"
      },
      {
        "id": "s6",
        "action": "assertCount",
        "targetDescription": "Cart contains exactly one line item",
        "locatorHint": "css=.float-cart .shelf-item"
      },
      {
        "id": "s7",
        "action": "assertContainsText",
        "targetDescription": "Selected product name is displayed in cart",
        "locatorHint": "css=.float-cart",
        "assertion": "Cropped Stay Groovy off white"
      },
      {
        "id": "s8",
        "action": "assertContainsText",
        "targetDescription": "Cart item price is $10.90",
        "locatorHint": "css=.float-cart",
        "assertion": "$10.90"
      },
      {
        "id": "s9",
        "action": "assertContainsText",
        "targetDescription": "Quantity defaults to 1",
        "locatorHint": "css=.float-cart",
        "assertion": "1"
      },
      {
        "id": "s10",
        "action": "assertContainsText",
        "targetDescription": "Cart subtotal equals $10.90",
        "locatorHint": "css=.float-cart .sub-price__val",
        "assertion": "$10.90"
      },
      {
        "id": "s11",
        "action": "assertVisible",
        "targetDescription": "Checkout button is visible",
        "locatorHint": "css=.float-cart .buy-btn"
      },
      {
        "id": "s12",
        "action": "assertEnabled",
        "targetDescription": "Checkout button is enabled",
        "locatorHint": "css=.float-cart .buy-btn"
      },
      {
        "id": "s13",
        "action": "assertContainsText",
        "targetDescription": "Cart badge shows 1 item",
        "locatorHint": "css=.bag__quantity",
        "assertion": "1"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
